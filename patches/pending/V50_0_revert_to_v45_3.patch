-<script>
-var __HOST_THEME_CSS = "\n/* ================================================================\n   \ud83c\udfa8 HOST THEME OVERRIDE \u2014 \u062a\u0645 \u0631\u0648\u0634\u0646 \u0628\u0631\u0646\u0627\u0645\u0647\u0654 \u0645\u06cc\u0632\u0628\u0627\u0646 (\u0644\u0627\u06cc\u0647\u0654 \u062c\u062f\u0627\u06af\u0627\u0646\u0647)\n   \u0641\u0627\u06cc\u0644 \u0648\u06cc\u0631\u0627\u06cc\u0634\u06af\u0631 (math-editor.html) \u062f\u0633\u062a\u200c\u0646\u062e\u0648\u0631\u062f\u0647 \u0627\u0633\u062a\u061b \u0627\u06cc\u0646 \u0628\u0644\u0648\u06a9 \u062a\u0648\u0633\u0637\n   \u0628\u0631\u0646\u0627\u0645\u0647\u0654 \u0645\u06cc\u0632\u0628\u0627\u0646 \u062a\u0632\u0631\u06cc\u0642 \u0645\u06cc\u200c\u0634\u0648\u062f. \u062e\u0627\u0645\u0648\u0634/\u0631\u0648\u0634\u0646: window.__mathHostTheme.off() / .on()\n   ================================================================ */\n:root, html[data-theme]{\n  --bg:#e9eef5;\n  --bg1:#e9eef5; --bg2:#e3e9f2; --bg3:#edf1f8;\n  --text:#263142; --soft:#3d4b63; --dim:#5b6a80; --muted:#667386;\n  --card:rgba(255,255,255,.66); --card-brd:rgba(38,49,66,.12);\n  --input-bg:#ffffff; --input-brd:rgba(38,49,66,.22);\n  --shadow:rgba(141,153,170,.38);\n  --accent:#6c63f5; --accent2:#27c4a8;\n  --ok:#27c4a8; --err:#c85b6b;\n  --panel:rgba(38,49,66,.05);\n}\n/* \u0628\u0648\u0645 \u0641\u0631\u0645\u0648\u0644 \u2014 \u0633\u0641\u06cc\u062f \u0645\u062b\u0644 \u062d\u0627\u0644\u062a \u063a\u06cc\u0631\u062a\u0645\u0627\u0645\u200c\u0635\u0641\u062d\u0647\u0654 \u062e\u0648\u062f\u0650 \u0641\u0627\u06cc\u0644 */\n#mfModal.box-fullscreen .mf-box{color:var(--text) !important}\n#mfModal.box-fullscreen .mb-canvas{background:#ffffff !important;color:#111111 !important;box-shadow:inset 0 2px 10px rgba(38,49,66,.07) !important}\n#mfModal.box-fullscreen .mb-slot:not(.mb-root),\n#mfModal.box-fullscreen .mb-slot.mb-filled:not(.mb-act):not(.mb-root),\n#mfModal.box-fullscreen .mb-slot.mb-filled.mb-act:not(.mb-root){color:#111111 !important}\n#mfModal.box-fullscreen .mb-slot:not(.mb-root){background:rgba(108,99,245,.07) !important}\n#mfModal.box-fullscreen .mb-slot.mb-act:not(.mb-root){background:rgba(108,99,245,.16) !important;box-shadow:0 0 0 2px rgba(108,99,245,.3) !important}\n.mb-canvas:focus-within{box-shadow:0 0 0 4px rgba(108,99,245,.18) !important}\n/* \u0645\u062a\u0646 \u062a\u06cc\u0631\u0647 \u0631\u0648\u06cc \u062f\u06a9\u0645\u0647\u200c\u0647\u0627/\u062a\u0631\u0627\u0634\u0647\u200c\u0647\u0627/\u0641\u06cc\u0644\u062f\u0647\u0627\u06cc \u0631\u0648\u0634\u0646 */\n.mb-fixed-keypad button,\n.mb-kt,\n.mb-top-six-btn,.mb-top-six-input-btn,.mb-top-six-input input,\n.mb-recent-use,.mb-recent-del,\n.mb-quick button,\n#mfModal.box-fullscreen .mb-chip,\n#mfModal.box-fullscreen #mfPad.mb-library-open .mfk,\n#mfModal.box-fullscreen #mfPad.mb-library-open .mb-library-close{color:var(--text) !important}\n.mb-fixed-keypad button:hover,\n.mb-kt:hover,\n.mb-top-six-btn:hover,.mb-top-six-input-btn:hover,\n#mfModal.box-fullscreen #mfPad.mb-library-open .mfk:hover{background:rgba(38,49,66,.06) !important}\n.mb-quick button:hover{background:rgba(108,99,245,.12) !important}\n/* \u062f\u06a9\u0645\u0647\u200c\u0647\u0627\u06cc \u06af\u0631\u0627\u062f\u06cc\u0627\u0646\u06cc \u2014 \u0645\u062a\u0646 \u0633\u0641\u06cc\u062f \u0628\u0645\u0627\u0646\u062f */\n.mb-kt-apply,.mb-fixed-keypad .mb-keyboard,.mb-quick .mb-chip{color:#ffffff !important}\n/* \u0644\u0647\u062c\u0647\u200c\u0647\u0627: \u0641\u06cc\u0631\u0648\u0632\u0647\u200c\u0627\u06cc \u0646\u0626\u0648\u0646\u06cc \u2192 \u062e\u0627\u0646\u0648\u0627\u062f\u0647\u0654 \u0628\u0646\u0641\u0634/\u0641\u06cc\u0631\u0648\u0632\u0647\u200c\u0627\u06cc/\u0642\u0631\u0645\u0632 \u0628\u0631\u0646\u0627\u0645\u0647 */\n.mb-fixed-keypad .mb-opkey{background:rgba(108,99,245,.1) !important;border-color:rgba(108,99,245,.35) !important;color:var(--accent) !important}\n.mb-kt-quick{background:rgba(108,99,245,.1) !important;border-color:rgba(108,99,245,.35) !important}\n.mb-fixed-keypad .mb-clearall{background:rgba(200,91,107,.12) !important;border-color:rgba(200,91,107,.35) !important}\n.mb-top-six-input-btn.ghost{background:rgba(38,49,66,.06) !important}\n/* \u067e\u0627\u067e\u200c\u0622\u067e \u25be \u0648 \u0645\u0646\u0648\u0647\u0627\u06cc \u0634\u0646\u0627\u0648\u0631 (\u0627\u0632 \u062c\u0645\u0644\u0647 \u062f\u06a9\u0645\u0647\u200c\u0647\u0627\u06cc inline-style \u0645\u0627\u062a\u0631\u06cc\u0633) */\n.mb-var{background:#ffffff !important;box-shadow:0 14px 40px rgba(38,49,66,.22) !important}\n.mb-var .mbv-i,.mb-var .mbv-cat,.mb-var button,.mb-var .mbv-rt{color:var(--text) !important}\n.mb-var button[style*=\"linear-gradient\"]{color:#ffffff !important}\n.mb-var .mbv-i:hover,.mb-var .mbv-cat:hover,.mb-var button:not([style*=\"linear-gradient\"]):hover{background:rgba(108,99,245,.1) !important}\n/* \u0628\u0631\u0627\u06a9\u062a \u062a\u06a9\u200c\u0637\u0631\u0641\u0647\u0654 \u06a9\u0634\u06cc\u062f\u0647: \u0646\u0642\u0637\u0647\u0654 null-delimiter \u0644\u0627\u062a\u06a9 (\\left[ \u2026 \\right.) \u062f\u0631 \u0628\u0648\u0645 \u062f\u06cc\u062f\u0647 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f */\n.mb-par > .mdelim[data-dch=\".\"]{display:none !important}\n/* ================================================================\n   \u2328\ufe0f \u0641\u0642\u0637 \u0646\u0633\u062e\u0647\u0654 \u062f\u0633\u06a9\u062a\u0627\u067e (\u2265\u06f5\u06f6\u06f1px): \u062d\u0630\u0641 \u062f\u06a9\u0645\u0647\u200c\u0647\u0627\u06cc \u06f0\u2013\u06f9\u060c \u062c\u0647\u062a\u200c\u0647\u0627\u060c \u232b\u060c \u062f\u06a9\u0645\u0647\u0654\n   \u06a9\u06cc\u0628\u0648\u0631\u062f\u060c \u0648 (\u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062f\u0648\u0645) \u0639\u0645\u0644\u06af\u0631\u0647\u0627\u06cc \u00d7 \u00f7 + \u2212 = \u0648 \u062f\u06a9\u0645\u0647\u0654 \u21b5.\n   \u0639\u0645\u0644\u06a9\u0631\u062f \u0647\u0645\u0647\u0654 \u0622\u0646\u200c\u0647\u0627 \u0628\u0627 \u06a9\u0644\