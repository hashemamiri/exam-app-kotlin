+    fun applyCurrent() {
+        val tex = currentTex()
+        if (tex.isBlank()) { onDismiss(); return }
+        if (!NativeMathFormatter.isBalanced(tex)) {
+            error = "آکولادهای فرمول متوازن نیستند."
+            return
+        }
+        store.addRecentFormula(tex)
+        recentFormulas = store.recentFormulas()
+        onInsert(tex)
+    }
