-    function isWord(c) { return /[a-zA-Z\u0600-\u06FF\u200c]/.test(c); }
-    function assemble(toks) {
-      let arr = toks.slice();
-      for (let e = arr.length - 1; e >= 0; e--) {
-        if (!arr[e] || (!arr[e].pow && !arr[e].low)) continue;
-        let a = e - 1;
-        while (a >= 0 && arr[a] && arr[a].sp) a--;
-        let b = e + 1;
-        while (b < arr.length && arr[b] && arr[b].sp) b++;
-        const left = (a >= 0 && arr[a]) ? arr[a] : { x: '' };
-        const right = (b < arr.length && arr[b]) ? arr[b] : { x: '' };
-        const op = arr[e].pow ? '^' : '_';
-        const rep = { x: (left.grp, left.x + op + '{' + (right.grp != null ? right.grp : right.x) + '}'), atom: true };
-        const from = a >= 0 ? a : e;
-        arr.splice(from, b - from + 1, rep);
-        e = from;
-      }
-      for (let e = 0; e < arr.length; e++) {
-        if (!arr[e] || !arr[e].div) continue;
-        let a = e - 1;
-        while (a >= 0 && arr[a] && arr[a].sp) a--;
-        let b = e + 1;
-        while (b < arr.length && arr[b] && arr[b].sp) b++;
-        const left = (a >= 0 && arr[a]) ? arr[a] : { x: '' };
-        const right = (b < arr.length && arr[b]) ? arr[b] : { x: '' };
-        const rep = { x: '\\frac{' + (left.grp != null ? left.grp : left.x) + '}{' + (right.grp != null ? right.grp : right.x) + '}', atom: true };
-        const from = a >= 0 ? a : e;
-        arr.splice(from, b - from + 1, rep);
-        e = from;
-      }
-      return arr.map(x => x ? x.x : '').join('');
-    }
-    return assemble((function parse(stop) {
-      const toks = [];
-      for (; n < t.length;) {
-        const c = t[n];
-        if (stop && c === stop) break;
-        if (c === ' ') { n++; if (toks.length) toks.push({ x: ' ', sp: true }); continue; }
-        if (c === '(') {
-          n++;
-          const inner = parse(')');
-          if (t[n] === ')') n++;
-          const s = assemble(inner);
