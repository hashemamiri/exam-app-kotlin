-function qMathSync(fieldId) {
-  try {
-    const t = el(fieldId);
-    if (!t) return;
-    let view = el(qMathViewId(fieldId));
-    if (!view) {
-      const wrap = t.parentNode;
-      if (!wrap) return;
-      if (!wrap.classList.contains('q-math-field')) wrap.classList.add('q-math-field');
-      view = document.createElement('div');
-      view.id = qMathViewId(fieldId);
-      view.className = 'q-math-view';
-      view.setAttribute('aria-hidden', 'true');
-      wrap.insertBefore(view, t.nextSibling);
-    }
-    const wrap = t.parentNode;
-    if (wrap && !wrap.classList.contains('q-math-field')) wrap.classList.add('q-math-field');
-    const v = t.value || '';
-    const has = qMathHas(v);
-    t.classList.remove('q-math-hide-text');
-    if (!has) {
-      view.innerHTML = '';
-      view.classList.remove('show');
-      return;
-    }
-    const rendered = (typeof renderMathText === 'function') ? renderMathText(v).replace(/\n/g, '<br>') : esc(v);
-    view.innerHTML = '<div class="q-math-scroll">' + rendered + '</div>';
-    view.classList.add('show');
-    if (typeof mbFitAllSurds === 'function') mbFitAllSurds(view);
-    if (typeof fitMathStretchers === 'function') fitMathStretchers(view);
-    else if (typeof mbFitAllDelims === 'function') mbFitAllDelims(view);
