-    fun handleUndo() {
-        if (undoStack.isNotEmpty()) {
-            val previous = undoStack.removeAt(undoStack.lastIndex)
-            redoStack.add(currentTex)
-            currentTex = previous
-        }
-    }
-
-    fun handleRedo() {
-        if (redoStack.isNotEmpty()) {
-            val next = redoStack.removeAt(redoStack.lastIndex)
-            undoStack.add(currentTex)
-            currentTex = next
-        }
-    }
