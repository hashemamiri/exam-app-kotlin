-function mfSmartChemNormalize(src) {
-  let t = String(src || '');
-  /* فرمول‌های رایج شیمی: اندیس پایین + بار یون بالا */
-  t = t.replace(/([A-Za-z\)])(\d+)([+-])/g, '$1^{$2$3}');
-  t = t.replace(/([A-Za-z\)])([+-])/g, '$1^{$2}');
-  t = t.replace(/\b([A-Z][A-Za-z0-9()]+)\b/g, function (tok) {
-    if (!/[0-9]/.test(tok)) return tok;
-    if (/\^\{/.test(tok)) return tok;
-    return tok.replace(/([A-Za-z\)])(\d+)/g, '$1_{$2}');
-  });
-  t = t.replace(/\b(SO4|CO3|PO4|NO3|NH4|HCO3)(?:\s*)(\d+)([+-])/g, function (_, ion, n, s) {
-    return ion.replace(/([A-Za-z])(\d+)/g, '$1_{$2}') + '^{' + n + s + '}';
-  });
-  return t;
-}
-function mfSmartQuickToTex(src) {
-  let t = mfSmartChemNormalize(src);
-  t = t.replace(/⇌/g, ' rightleftharpoons ');
