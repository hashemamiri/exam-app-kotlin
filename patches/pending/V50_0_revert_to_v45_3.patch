+                    }
+                }
+                item {
+                    LazyRow(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                        item {
+                            OutlinedButton(onClick = { if (lastFormula.isNotBlank()) closeAndReplace(lastFormula) }) {
