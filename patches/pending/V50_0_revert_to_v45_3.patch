-          while (n < t.length && isNum(t[n])) s += t[n++];
-          toks.push({ x: s, atom: true });
-          continue;
-        }
-        if (isWord(c)) {
-          let w = '';
-          while (n < t.length && isWord(t[n])) w += t[n++];
-          const low = w.toLowerCase();
-          if (NAT_WORD[w] || NAT_WORD[low]) {
-            const rep = NAT_WORD[w] || NAT_WORD[low];
-            if (rep === '\\sqrt' || rep === '\\vec') {
-              while (t[n] === ' ') n++;
-              let arg = '';
-              if (t[n] === '(') {
-                n++;
-                const inner = parse(')');
-                if (t[n] === ')') n++;
-                arg = assemble(inner);
-              } else {
-                let s = '';
-                if (isNum(t[n])) while (n < t.length && isNum(t[n])) s += t[n++];
-                else if (isWord(t[n])) s = t[n++];
-                arg = s;
-              }
-              toks.push({ x: rep + '{' + arg + '}', atom: true });
-              continue;
-            }
-            if (rep === '\\sum' || rep === '\\int' || rep === '\\lim') {
-              toks.push({ x: rep + ' ', big: true, atom: true });
-              continue;
-            }
-            toks.push({ x: rep + ' ', atom: true });
-            continue;
-          }
-          toks.push({ x: w.length > 1 ? '\\text{' + w + '}' : w, atom: true });
-          continue;
-        }
-        const two = t.substr(n, 2);
-        const map = { '>=': '\\ge ', '<=': '\\le ', '!=': '\\ne ', '+-': '\\pm ', '->': '\\to ', '=>': '\\Rightarrow ', '~=': '\\approx ', '**': '^' };
-        if (map[two]) {
-          n += 2;
-          if (map[two] === '^') toks.push({ x: '^', pow: true });
-          else toks.push({ x: map[two] });
-        } else {
-          n++;
-          if (c === '/') toks.push({ x: '/', div: true });
-          else if (c === '^') toks.push({ x: '^', pow: true });
-          else if (c === '_') toks.push({ x: '_', low: true });
-          else if (c === '*' || c === '×') toks.push({ x: '\\times ' });
-          else if (c === '÷') toks.push({ x: '\\div ' });
-          else toks.push({ x: c });
-        }
-      }
-      return toks;
-    })(null)).trim();
-  }
