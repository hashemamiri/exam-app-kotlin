-/* ============================================================
- *  بهینه‌سازی سرعت (نسخهٔ ۷.۴)
- *  هیچ‌کدام از قوانین زیر ظاهر را تغییر نمی‌دهند؛
- *  فقط به مرورگر می‌گویند چه کاری را لازم نیست انجام دهد.
- * ============================================================ */
-
-/* ۱) کارت‌های خارج از دید اصلاً رندر نشوند (تا ۴ برابر سریع‌تر).
- *    contain-intrinsic-size ارتفاع تقریبی می‌دهد تا نوار اسکرول نپرد. */
-/* فقط جایی که اندازه‌گیری واقعی سود نشان داد: لیست آزمون‌ها.
- * (روی تب تصحیح هم آزمایش شد ولی چون هر کارت آن‌جا خیلی بلند است
- *  و تقریباً همیشه داخل کادر دید قرار دارد، نتیجه کُندتر شد → اعمال نشد.)
- *
- * ۳۸۴px = ۴۲۲px ارتفاع واقعی کارت منهای ۳۸px پدینگ و حاشیه،
- * چون contain-intrinsic-size ارتفاع «محتوا» را می‌گیرد نه کل کادر را.
- * با این عدد ارتفاع کل صفحه دقیقاً مثل قبل است و نوار اسکرول نمی‌پرد.
- * «auto» یعنی بعد از اولین نمایشِ هر کارت، ارتفاع واقعی جای این عدد را می‌گیرد. */
-#examsList > .card {
-  content-visibility: auto;
-  contain-intrinsic-size: auto 384px;   /* موبایل: کارت ۴۲۲px منهای ۳۸px پدینگ */
-}
-@media (min-width: 769px) {
-  #examsList > .card { contain-intrinsic-size: auto 321px; }  /* دسکتاپ: کارت ۳۷۳px منهای ۴۰px */
-}
-
-/* ۲) انیمیشن ورود روی خودِ ظرف اجرا شود نه تک‌تک ده‌ها کارت.
- *    چون همهٔ کارت‌ها هم‌زمان درج می‌شوند، نتیجهٔ بصری مو‌به‌مو یکی است. */
-#examsList.fade-in > .card.fade-in,
-#gradingBody.fade-in > .card.fade-in {
-  animation: none;
-}
-
-/* ۳) شفاف‌سازی نیت اسکرول برای مرورگر (اسکرول نرم‌تر روی گوشی) */
-.main-content, .drawer, .modal-box { -webkit-overflow-scrolling: touch; }
-
-/* ۴) hover فقط روی دستگاه‌هایی که واقعاً موشواره دارند اجرا شود.
- *    روی گوشی، :hover بعد از هر لمس «می‌چسبد» و باعث repaint بی‌مورد می‌شود. */
-@media (hover: none) {
-  .card:hover { transform: none; border-color: var(--card-brd); }
-  .zoomable:hover { transform: none; box-shadow: none; }
-  .stat-card:hover { border-color: var(--card-brd); }
-}
-
-/* ============================================================
- *  نسخهٔ ۷.۵ — تغییرات درخواستی کاربر
- * ============================================================ */
-
-/* عناصر قدیمی نوار بالا که حالا داخل «پنل معلم» نمایش داده می‌شوند.
-   حذفشان نکردیم چون منطق برنامه هنوز مقدارشان را می‌نویسد و
-   «پنل معلم» همان مقادیر را می‌خواند.
-   ⚠️ با شناسه هدف گرفته شده‌اند نه با کلاس، چون initStorage و
-      renderQuotaBadge خاصیت className را کامل بازنویسی می‌کنند. */
-.navbar #teacherName,
-.navbar #teacherDisplayBadge,
-.navbar #planBadge,
-.navbar #storageStatus { display: none !important; }
-
-/* ---------- دکمه‌های دوحالته (جای چک‌باکس) ---------- */
-.toggle-row {
-  display: flex;
-  gap: 10px;
-  flex-wrap: wrap;
-}
-.toggle-btn {
-  flex: 1;
-  min-width: 0;
-  padding: 12px 14px;
-  border-radius: 11px;
-  border: 1px solid var(--input-brd);
-  background: var(--input-bg);
-  color: var(--soft);
-  font-family: inherit;
-  font-size: 0.8125rem;
-  cursor: pointer;
-  transition: background .18s, color .18s, border-color .18s;
-  text-align: center;
-  white-space: nowrap;
-  overflow: hidden;
-  text-overflow: ellipsis;
-}
-.toggle-btn:hover { border-color: var(--accent); }
-.toggle-btn.on {
-  background: linear-gradient(135deg, var(--accent2), var(--accent));
-  border-color: transparent;
-  color: #fff;
-  font-weight: 700;
-}
-.gender-row .toggle-btn { flex: 1; }
-
-/* ---------- پنل معلم (کشویی گوشهٔ بالا) ---------- */
-/* صفحه RTL است، پس «آخرین» عنصر فلکس فیزیکاً سمت چپ می‌افتد.
-   با order صریح، پنل معلم در هر اندازهٔ صفحه گوشهٔ چپ می‌ماند
-   (چه همبرگر دیده شود چه نشود). */
-.navbar .burger    { order: 1; }
-.navbar .user-info { order: 2; }
-.tp-wrap           { order: 3; position: relative; margin-inline-start: auto; }
-.tp-btn {
-  background: none;
-  border: none;
-  padding: 0;
-  font-family: inherit;
-  cursor: pointer;
-  display: inline-flex;
-  align-items: center;
-  gap: 6px;
-}
-/* .logo از قبل گرادیان متنی دارد؛ فقط فلش را رنگی می‌کنیم */
-.tp-caret {
-  -webkit-text-fill-color: var(--muted);
-  font-size: 0.75rem;
-  transition: transform .2s;
-}
-.tp-btn[aria-expanded="true"] .tp-caret { transform: rotate(180deg); }
-
-.tp-menu {
-  position: absolute;
-  top: calc(100% + 10px);
-  /* دکمه در گوشهٔ چپ است، پس منو هم از لبهٔ چپِ دکمه به راست باز می‌شود.
-     مختصات فیزیکی می‌دهیم تا در RTL از صفحه بیرون نزند. */
-  left: 0;
-  right: auto;
-  min-width: 262px;
-  /* هرگز از لبهٔ صفحه بیرون نزند */
-  max-width: min(320px, calc(100vw - 20px));
-  /* پس‌زمینهٔ مات لازم است؛ با var(--card) که نیمه‌شفاف است
-     متنِ پشتِ منو از لای آن دیده می‌شد. */
-  background: #241f47;
-  border: 1px solid var(--card-brd);
-  border-radius: 14px;
-  box-shadow: 0 12px 34px rgba(0,0,0,.5);
-  padding: 8px;
-  z-index: 300;
-  display: none;
-}
-html[data-theme="light"] .tp-menu {
-  background: #fff;
-  box-shadow: 0 12px 34px rgba(30,40,80,.22);
-}
-.tp-menu.open { display: block; animation: tpIn .16s ease; }
-@keyframes tpIn {
-  from { opacity: 0; transform: translateY(-6px); }
-  to   { opacity: 1; transform: translateY(0); }
-}
-.tp-row {
-  display: flex;
-  justify-content: space-between;
-  align-items: center;
-  gap: 12px;
-  padding: 10px 12px;
-  border-radius: 9px;
-}
-.tp-row + .tp-row { border-top: 1px solid var(--card-brd); }
-.tp-key { font-size: 0.75rem; color: var(--muted); white-space: nowrap; }
-.tp-val {
-  font-size: 0.8125rem;
-  color: var(--text);
-  font-weight: 600;
-  text-align: left;
-  overflow-wrap: anywhere;
-}
-.tp-val.ok   { color: var(--ok); }
-.tp-val.warn { color: var(--warn); }
