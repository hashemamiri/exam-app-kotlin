-    fun handleBackspace() {
-        if (currentTex.isEmpty()) return
-        val text = currentTex
-        val lastBackslash = text.lastIndexOf('\\')
-        val updated = if (lastBackslash >= 0 && (text.length - lastBackslash) <= 15 && text.substring(lastBackslash).all { it == '\\' || it.isLetter() }) {
-            text.substring(0, lastBackslash)
-        } else if (text.endsWith("^{2}") || text.endsWith("_{n}") || text.endsWith("^{n}")) {
-            text.substring(0, text.length - 4)
-        } else if (text.endsWith("\\frac{a}{b}") || text.endsWith("\\sqrt{x}")) {
-            text.substring(0, text.lastIndexOf('\\'))
-        } else {
-            text.dropLast(1)
-        }
-        updateTex(updated)
-    }
