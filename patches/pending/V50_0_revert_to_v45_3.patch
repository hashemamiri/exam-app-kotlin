-            symbolLatex
-        } else {
-            val endsWithSlash = currentTex.endsWith("\\")
-            val endsWithLetter = currentTex.isNotEmpty() && currentTex.last().isLetter()
-            val startsWithLetter = symbolLatex.isNotEmpty() && symbolLatex.first().isLetter()
