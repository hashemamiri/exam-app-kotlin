+    fun htmlToText(html: String): String {
+        val sb = StringBuilder()
+        var inTag = false
+        for (c in html) {
+            when {
+                c == '<' -> { inTag = true; sb.append(' ') }
+                c == '>' -> inTag = false
+                !inTag -> sb.append(c)
+            }
+        }
