+package ir.exam.app
+
+import ir.exam.app.domain.bank.ReferenceBankMedia
+import ir.exam.app.domain.bank.ReferenceBankQuestion
+import ir.exam.app.ui.bank.toBankQuestionOption
+import ir.exam.app.ui.builder.QuestionType
+import java.io.File
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * V363 — متن بانک مرجع در همهٔ پایه‌ها دیده شود.
+ *
+ * گزارش کاربر: در بانک مرجع، متن یا گزینه‌های سؤال در پایه‌های ششم، هفتم و
+ * هشتم دیده نمی‌شد و فقط پیش‌نمایش سالم بود.
+ *
+ * ریشه (بررسی شاردهای واقعی روی فضای ابری): این پایه‌ها فیلد `text` را خالی
+ * گذاشته‌اند و متن کامل فقط در `q_html` است؛ فهرست بانک و سؤالِ افزوده‌شده
+ * به آزمون همان `text` را می‌خواندند. همچنین شارد سؤال پایهٔ هشتم روی سرور
+ * نیست و باید دوباره بارگذاری شود.
+ *
+ * این تست هم رفتار پل (text ← q_html) را می‌آزماید و هم پین می‌کند که در
+ * اپ، سایت و ابزار ترمیم شارد باقی بماند.
+ */
+class V363_ReferenceBankTextTest {
+
+    private fun root(): File {
+        var d = File(System.getProperty("user.dir") ?: ".")
+        while (!File(d, "settings.gradle.kts").exists() && d.parentFile != null) d = d.parentFile!!
+        return d
+    }
+
+    private fun src(path: String): String = File(root(), path).readText(Charsets.UTF_8)
+
+    private fun question(text: String, qHtml: String, options: List<String> = emptyList(),
+                         optionImages: List<String?>? = emptyList())
+        = ReferenceBankQuestion(
+            id = 7, grade = 6, subject = "ریاضی", type = "multiple",
+            text = text, qHtml = qHtml, options = options, optionImages = optionImages
+        )
+
+    @Test
+    fun emptyTextFallsBackToQuestionHtml() {
+        val q = question("", "<div>کدام‌یک از اعداد زیر بر ۳ بخش‌پذیر است؟</div>")
+        val draft = q.toBankQuestionOption().question
+        assertEquals("کدام‌یک از اعداد زیر بر ۳ بخش‌پذیر است؟", draft.text)
+    }
+
+    @Test
+    fun readyTextWinsAndKeepsFormulas() {
+        val q = question("متن آمادهٔ گزینه‌ها", "<div>متن html</div>",
+            options = listOf("$\\text{۲}$", "$\\text{۴}$", "$\\text{۶}$", "$\\text{۸}$"))
+        val draft = q.toBankQuestionOption().question
+        assertEquals("متن آمادهٔ گزینه‌ها", draft.text)
+        assertTrue(draft.options.contains("$\\text{۴}$"))
+    }
+
+    @Test
+    fun halfSpaceSurvivesHtmlToText() {
+        val value = ReferenceBankMedia.htmlToText("<span>می‌شود</span> و <b>نمی‌شود</b>")
+        assertTrue("نیم‌فاصله نباید به فاصله شکسته شود", value.contains("می‌شود"))
+        assertTrue(value.contains("نمی‌شود"))
+        assertEquals("الف ب", ReferenceBankMedia.htmlToText("<p>الف</p>\n<p>ب</p>"))
+    }
+
+    @Test
+    fun listSnippetIsShortenedWithEllipsis() {
+        val long = "ا".repeat(300)
+        val cut = ReferenceBankMedia.displayText(long, "", 40)
+        assertEquals(41, cut.length)
+        assertTrue(cut.endsWith("…"))
+        assertEquals(long, ReferenceBankMedia.displayText(long, "", 0))
+    }
+
+    @Test
+    fun blankOptionsBecomeEssayUnlessTheyHaveImages() {
+        val blank = question("", "<div>سؤال</div>", options = listOf("", "", "", ""))
+        assertEquals(QuestionType.ESSAY, blank.toBankQuestionOption().question.type)
+
+        val withImages = question("", "<div>سؤال</div>", options = listOf("", "", "", ""),
+            optionImages = listOf("https://x/1.webp", "https://x/2.webp", null, null))
+        assertEquals(QuestionType.MULTIPLE_CHOICE, withImages.toBankQuestionOption().question.type)
+    }
+
+    @Test
+    fun appSiteAndRepairToolCarryTheBridge() {
+        val models = src("app/src/main/java/ir/exam/app/domain/bank/ReferenceBankModels.kt")
+        assertTrue("fun displayText(text: String, qHtml: String, limit: Int = 0)" in models)
+        assertTrue("fun htmlToText(html: String): String" in models)
+        assertTrue("SHARD_VERSION = \"v3630\"" in models)
+
+        val mapper = src("app/src/main/java/ir/exam/app/ui/bank/ReferenceBankMapper.kt")
+        assertTrue("ReferenceBankMedia.displayText(text, qHtml)" in mapper)
+
+        val site = src("site/src/refbank.js")
+        assertTrue("p.text || plainQuestion(p.q_html)" in site)
+        assertTrue("function plainQuestion(html)" in site)
+        assertTrue("SHARD_VERSION = 'v3630'" in site)
+
+        val dialog = src("app/src/main/java/ir/exam/app/ui/bank/ReferenceBankDialog.kt")
+        assertTrue("در فهرست این پایه نیست" in dialog)
+
+        val tool = File(root(), "scripts/repair_reference_bank_text.py")
+        assertTrue("ابزار ترمیم شارد باید موجود باشد", tool.isFile)
+        val text = tool.readText(Charsets.UTF_8)
+        assertTrue("\"--check\"" in text)
+        assertTrue("\"--with-questions\"" in text)
+
+        val android = src(".github/workflows/android.yml")
+        assertTrue("check_reference_bank_text" in android)
+        assertTrue("check_reference_bank_text.py" in src(".github/workflows/site.yml"))
+    }
+}
